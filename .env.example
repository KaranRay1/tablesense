# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- Sign-in (required to open the web app to other devices) ---
# Floor staff: 4-8 digits. Owner: 10+ characters. They must differ.
TABLESENSE_STAFF_PIN=
TABLESENSE_OWNER_PASSWORD=
# Optional: 32+ random characters, keeps everyone signed in across restarts.
TABLESENSE_SESSION_SECRET=

# --- Push notifications via ntfy (FREE) ---
# Install the ntfy app on each phone and subscribe to this topic.
# Make it long and random: anyone who knows it can read the alerts.
# Generate one: .venv/bin/python -c "from tablesense.notify import new_topic; print(new_topic())"
TABLESENSE_NTFY_TOPIC=
# Default https://ntfy.sh. Later: your own ntfy server on the venue's edge box.
TABLESENSE_NTFY_SERVER=
TABLESENSE_NTFY_TOKEN=

# --- Email (Gmail example) ---
# Gmail needs an "app password" (Google Account > Security > 2-Step Verification > App passwords),
# not your normal password.
TABLESENSE_SMTP_HOST=smtp.gmail.com
TABLESENSE_SMTP_PORT=587
TABLESENSE_SMTP_USER=you@gmail.com
TABLESENSE_SMTP_PASSWORD=
TABLESENSE_EMAIL_FROM=
# Comma-separated staff addresses
TABLESENSE_EMAIL_TO=

# --- Texts from YOUR OWN number via the Mac Messages app (FREE, Mac only) ---
# Needs Messages signed in on this Mac and, for SMS, Text Message Forwarding
# turned on for this Mac on your iPhone. Uses TABLESENSE_SMS_TO below as recipients.
# SMS reaches any phone; iMessage only Apple devices.
TABLESENSE_MESSAGES_SERVICE=SMS

# --- SMS via Twilio (free trial to start; then paid per message) ---
# From the Twilio console home page: Account SID, Auth Token, and your Twilio phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Comma-separated, international format, e.g. +3538XXXXXXXX
TABLESENSE_SMS_TO=
